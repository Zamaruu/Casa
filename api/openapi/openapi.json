{
  "openapi": "3.0.3",
  "info": {
    "title": "Casa API",
    "description": "Private family API for the Casa app. This API is used by the Flutter app and external tools (e.g., n8n).",
    "version": "0.4.0"
  },
  "tags": [
    {
      "name": "Health",
      "description": "System & Health Endpoints"
    },
    {
      "name": "Users",
      "description": "Benutzerverwaltung"
    },
    {
      "name": "Auth",
      "description": "Authentifizierung"
    },
    {
      "name": "API-Schlüssel",
      "description": "API-Schlüsselverwaltung"
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Benutzer einloggen",
        "description": "Meldet den Benutzer mittels E-Mail und Passwort ein. Bei erfolg wirf JWT zurückgegeben.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JwtLoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JWT zurückgegeben",
            "content": {
              "application/json": {
                "schema": {

                }
              }
            }
          }
        }
      }
    },
    "/api/meta/healthcheck": {
      "get": {
        "tags": ["Health"],
        "summary": "Health Check",
        "description": "Prüft, ob die API erreichbar ist",
        "responses": {
          "200": {
            "description": "API ist erreichbar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/meta/version": {
      "get": {
        "tags": ["Health"],
        "summary": "Version des Servers abrufen",
        "description": "Gibt die Version des Servers zurück",
        "responses": {
          "200": {
            "description": "Version des Servers",
            "content": {
              "application/json": {

              }
            }
          }
        }
      }
    },
    "/api/user": {
      "get": {
        "tags": ["Users"],
        "summary": "Alle Benutzer abrufen",
        "security": [
          {
            "jwt": []
          },
          {
            "apikey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Liste aller Benutzer",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Users"],
        "summary": "Benutzer erstellen",
        "security": [
          {
            "jwt": []
          },
          {
            "apikey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Benutzer wurde erstellt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    },
    "/api/user/{userId}": {
      "get": {
        "tags": ["Users"],
        "summary": "Benutzer anhand der ID abrufen",
        "security": [
          {
            "jwt": []
          },
          {
            "apikey": []
          }
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Benutzer gefunden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "404": {
            "description": "Benutzer nicht gefunden"
          }
        }
      }
    },
    "/api/backend/apikeys": {
      "post": {
        "tags": ["API-Schlüssel"],
        "summary": "API-Schlüssel erstellen",
        "security": [
          {
            "jwt": []
          },
          {
            "apikey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApiKeyRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "API-Schlüssel erstellt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateApiKeyResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "API-Schlüssel"
        ],
        "summary": "Alle verfügbaren API-Schlüssel abrufen",
        "security": [
          {
            "jwt": []
          },
          {
            "apikey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Liste aller verfügbaren API-Schlüssel",
            "content": {
              "application/json": {
                "schema" : {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CreateApiKeyRequest"
                  }
                }
              }
            }
          }
        }
      }
    }


  },
  "components": {
    "securitySchemes": {
      "jwt": {
        "type": "http",
        "scheme": "bearer",
        "name": "Authorization",
        "bearerFormat": "JWT",
        "description": "JSON Web Token für die Authentifizierung"
      },
      "apikey": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "scheme": "ApiKey",
        "description": "API-Schlüssel für die Authentifizierung"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "user_123"
          },
          "displayName": {
            "type": "string",
            "example": "Max"
          },
          "email": {
            "type": "string",
            "example": "max@example.com"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "required": ["displayName", "email"],
        "properties": {
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        }
      },
      "JwtLoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "JwtLoginResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          }
        }
      },
      "CreateApiKeyRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "ApiKey"
          },
          "description": {
            "type": "string",
            "example": "This is an API key"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "example": "2023-01-01T00:00:00Z"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "revokedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2023-01-01T00:00:00Z"
          },
          "lastUsedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2023-01-01T00:00:00Z"
          },
          "keyHash": {
            "type": "string",
            "example": "hash"
          }
        }
      },
      "CreateApiKeyResponse": {
        "type": "object",
        "properties": {
          "rawKey": {
            "type": "string",
            "example": "rawKey",
            "description": "The raw key used to create the API key"
          },
          "keyInfos": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "example": "user_123"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              },
              "name": {
                "type": "string",
                "example": "ApiKey"
              },
              "description": {
                "type": "string",
                "example": "This is an API key"
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time",
                "example": "2023-01-01T00:00:00Z"
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "revokedAt": {
                "type": "string",
                "format": "date-time",
                "example": "2023-01-01T00:00:00Z"
              },
              "lastUsedAt": {
                "type": "string",
                "format": "date-time",
                "example": "2023-01-01T00:00:00Z"
              },
              "keyHash": {
                "type": "string",
                "example": "hash"
              }
            }
          }
        }
      }
    }
  }
}
